      <property name="styleSheet">
       <string notr="true">/* Tableau principal */
table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
    font-size: 14px;
    background-color: #02767F;
    border: 1px solid #02767F;
}

/* Style des en-têtes de colonne */
th {
    background-color: #007bff;
    color: white;
    padding: 12px 15px;
    text-align: center;
    font-weight: bold;
}

/* Style des cellules de données */
td {
    padding: 12px 15px;
    text-align: center;
    border: 1px solid #ddd;
}

/* Style de la colonne &quot;Actions&quot; */
td.actions {
    display: flex;
    justify-content: center;
    gap: 10px;
}

/* Bouton Modifier */
button.modify-btn {
    background-color: #ffc107;
    color: black;
    border: none;
    padding: 8px 12px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 14px;
    transition: background-color 0.3s;
}

button.modify-btn:hover {
    background-color: #e0a800;
}

/* Bouton Supprimer */
button.delete-btn {
    background-color: #dc3545;
    color: white;
    border: none;
    padding: 8px 12px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 14px;
    transition: background-color 0.3s;
}

button.delete-btn:hover {
    background-color: #c82333;
}

/* Style de ligne lorsque la souris passe dessus */
tr:hover {
    background-color: #f1f1f1;
}

/* Style des lignes impaires pour un meilleur contraste */
tr:nth-child(odd) {
    background-color: #f7f7f7;
}

/* Style de la dernière colonne (Actions) */
td.actions {
    display: flex;
    justify-content: center;
    align-items: center;
}

/* Pour le contenu des images */
td img {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 50%;
}
QGroupBox {
    border: 2px solid #02767F; /* Couleur turquoise pour la bordure */
    border-radius: 10px;  /* Coins arrondis */
    padding: 10px;  /* Espacement interne */
    margin-bottom: 20px;  /* Espacement en bas */
}


</string>
      </property>
