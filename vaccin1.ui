       <property name="styleSheet">
        <string notr="true">QPushButton#pushButton_10 {
    background-color: transparent;
    color: #E74C3C;  /* Rouge */
    font-size: 13px;
    font-weight: bold;
    border: none;
    padding: 8px 15px;
    text-align: left;
}

QPushButton#pushButton_8:hover {
    color: #C0392B;  /* Rouge foncé au survol */
}

QPushButton#pushButton_8:pressed {
    color: #A93226;  /* Encore plus foncé au clic */
}

/* Ajouter une icône à gauche du texte */
QPushButton#pushButton_8::before {
    content: &quot;⏻ &quot;;  /* Icône de mise hors tension */
    font-size: 18px;
    margin-right: 8px;
}
</string>
