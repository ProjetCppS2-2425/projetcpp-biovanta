        <property name="styleSheet">
         <string notr="true">
QPushButton {
        background-color: #cbddf5; /* Rouge */
        color: white;
        border-radius: 5px;
        padding: 5px;
        font-weight: bold;
    }
    QPushButton:hover {
        background-color: #ff1a1a;  /* Rouge plus foncé au survol */
