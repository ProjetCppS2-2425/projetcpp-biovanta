  <property name="styleSheet">
   <string notr="true">/* Style global des boutons */
QPushButton {
    background-color: #34495E;  /* Bleu foncé */
    color: white;
    font-size: 14px;
    font-weight: bold;
    padding: 10px;
    border: none;
    text-align: left;
}

QPushButton:hover {
    background-color: #1ABC9C; /* Vert */
}

QPushButton:checked {
    background-color: #16A085; /* Vert foncé */
}

/* Spécifique au bouton &quot;Équipement&quot; */
QPushButton#btnEquipement {
    background-color: white;  /* Couleur de fond blanche */
    color: #34495E;  /* Texte bleu foncé */
}

QPushButton#btnEquipement:hover {
    background-color: #1ABC9C; /* Vert */
    color: white;  /* Texte blanc */
}

QPushButton#btnEquipement:checked {
    background-color: #16A085; /* Vert foncé */
    color: white;  /* Texte blanc */
}


</string>
