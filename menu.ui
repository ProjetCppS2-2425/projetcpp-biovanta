        <x>280</x>
        <y>220</y>
        <width>221</width>
        <height>51</height>
       </rect>
      </property>
      <property name="styleSheet">
       <string notr="true">#equip {
    background-color: #ffffff; /* Fond blanc */
    color: #003366;            /* Texte bleu foncé */
    border: 2px solid #003366;
    padding: 12px 24px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

#equip:hover {
    background-color: #f0f0f0; /* Survol gris clair */
}

#equip:active {
    background-color: #e0e0e0; /* Clic gris un peu plus foncé */
}
</string>
